<mxfile host="drawio"><diagram id="layers" name="Слои"><mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1160" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Адресная строка браузера&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;/cars?search=camry&amp;amp;brandId=4&amp;amp;fuel=hybrid&amp;amp;sort=year,desc&amp;amp;page=2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="30" width="760" height="62" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Маршруты — core/router.dart&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;GoRouter&lt;/font&gt; + &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ShellRoute&lt;/font&gt; с общим каркасом &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;AppShell&lt;/font&gt;&lt;br&gt;разбирает параметры адреса: &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;CarQuery.fromQueryParameters(uri)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f3e8ff;strokeColor=#7c3aed;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="150" width="760" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style=&quot;font-size:15px&quot;&gt;Экраны — screens/&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;CarListScreen&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ClientListScreen&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;CarDetailScreen&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ClientDetailScreen&lt;/font&gt;&lt;br&gt;описывают колонки и действия,&lt;br&gt;в репозиторий не обращаются" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8f0fb;strokeColor=#1f5fad;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="300" width="370" height="118" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Виджеты — widgets/&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;EntityTable&amp;lt;T&amp;gt;&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;EntityCardList&amp;lt;T&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ListStateView&amp;lt;T&amp;gt;&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;PaginationBar&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;DebouncedTextField&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;AppShell&lt;/font&gt;&lt;br&gt;общие для всех списков" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8f0fb;strokeColor=#1f5fad;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="605" y="300" width="370" height="118" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Состояние — state/  (provider, ChangeNotifier)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;EntityListNotifier&amp;lt;T, Q&amp;gt;&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;CarListNotifier&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ClientListNotifier&lt;/font&gt;&lt;br&gt;условия отбора, текущая страница, выделенные строки, удаление и восстановление&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ListState&amp;lt;T&amp;gt;&lt;/font&gt; (sealed): загрузка / данные / ошибка;  &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;DetailNotifier&amp;lt;T&amp;gt;&lt;/font&gt;,  &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;LookupNotifier&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e6f6f4;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="490" width="760" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Репозитории: интерфейс — repositories/&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;EntityRepository&amp;lt;T, Q&amp;gt;&lt;/font&gt; → &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;CarRepository&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ClientRepository&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;find(query)&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;findById&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;softDelete&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;hardDelete&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;restore&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;deleteMany(ids)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fdf3e3;strokeColor=#b45309;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="680" width="760" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style=&quot;font-size:15px&quot;&gt;Реализация в памяти (в ПР4 — реализация поверх API)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;InMemoryCarRepository&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;InMemoryClientRepository&lt;/font&gt;&lt;br&gt;поиск, фильтры, сортировка, страницы; &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;NetworkSimulator&lt;/font&gt; — задержка и имитация сбоя" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff8ee;strokeColor=#b45309;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="830" width="760" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Данные в памяти — seed_data.dart&lt;/b&gt;&lt;br&gt;34 автомобиля, 14 клиентов, 12 марок; после перезагрузки восстанавливаются" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fafafa;strokeColor=#9ca3af;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1"><mxGeometry x="215" y="980" width="760" height="58" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style=&quot;font-size:15px&quot;&gt;Модели — models/  (используются всеми слоями, сами ни от кого не зависят)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;Car&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;Client&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;Brand&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;FuelType&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;CarQuery&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ClientQuery&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;PageResult&amp;lt;T&amp;gt;&lt;/font&gt;, &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;ClientDetails&lt;/font&gt;&lt;br&gt;Связи: Car → Brand и Car → Client — многие к одному&lt;br&gt;CarQuery ⇄ адрес: &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;toQueryParameters()&lt;/font&gt; / &lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;fromQueryParameters()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=6;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="1080" width="760" height="104" as="geometry"/></mxCell><mxCell id="n11" value="разбор адреса" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="CarListScreen(query)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="359"/><mxPoint x="170" y="61"/></Array></mxGeometry></mxCell><mxCell id="n14" value="&lt;div style=&quot;text-align:right&quot;&gt;переход на новый адрес&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:12px&quot;&gt;context.go(&lt;br&gt;query.toLocation())&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="10" y="170" width="160" height="90" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="context.watch / context.read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="find(query), deleteMany(ids)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="PageResult&amp;lt;T&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="n7" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="реализует" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="n8" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#374151;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Правила границ:&lt;/b&gt; виджет не обращается к репозиторию напрямую — только через notifier; notifier не знает про BuildContext, виджеты и адрес; модель не знает ни про кого." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="215" y="1200" width="760" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>